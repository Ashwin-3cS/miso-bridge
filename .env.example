# Copy to .env and fill in. Never commit the filled copy.
NETWORK=testnet
DATABASE_URL=postgres://bridge:bridge@localhost:5433/bridge

AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
POLYGON_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
SUI_RPC_URL=https://fullnode.testnet.sui.io

# Gas-only keys. Leave unset for a read-only run.
# AVALANCHE_CRANK_KEY=
# POLYGON_CRANK_KEY=
# SUI_MINT_KEY=

# Circle's sandbox does not attest Sui-bound messages; see docs/operations.md.
IRIS_BASE_URL=https://iris-api-sandbox.circle.com

CRANK_FLOOR_USDC=1
API_PORT=8080
LOG_LEVEL=debug

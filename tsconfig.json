{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "paths": {
      "@misofm/cctp-forwarders/*": ["./vendor/cctp-forwarders/src/*"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
